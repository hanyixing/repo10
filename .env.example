# =============================================================================
# Solo deployment environment variables (EXAMPLE / template)
# -----------------------------------------------------------------------------
# Copy to `.env` for a manual `docker compose up`, or let `./deploy.sh <env>`
# generate `.env` from the matching application-<env>.yml. The real `.env` is
# git-ignored because it may contain secrets. These defaults are a runnable,
# NON-SENSITIVE localhost configuration.
# =============================================================================

# ---- Solo application config (consumed inside the container) ----------------
RUNTIME_DB=MYSQL
JDBC_USERNAME=root
JDBC_PASSWORD=solo-dev
JDBC_DRIVER=com.mysql.cj.jdbc.Driver
JDBC_URL=jdbc:mysql://mysql:3306/solo?useUnicode=yes&characterEncoding=UTF-8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
JDBC_MIN_CONNS=5
JDBC_MAX_CONNS=10
JDBC_TABLE_PREFIX=b3_solo

# ---- Public server identity (affects links Solo generates) ------------------
SERVER_SCHEME=http
SERVER_HOST=localhost

# ---- Solo container / orchestration -----------------------------------------
SOLO_IMAGE=b3log/solo:latest
SOLO_CONTAINER=solo
SOLO_HOST_PORT=8080
JAVA_OPTS=-Xms256m -Xmx512m
SOLO_MEM_LIMIT=512m
SOLO_CPU_LIMIT=1.0
SOLO_RESTART=unless-stopped

# ---- MySQL container --------------------------------------------------------
MYSQL_IMAGE=mysql:8.0
MYSQL_CONTAINER=solo-mysql
MYSQL_ROOT_PASSWORD=solo-dev
MYSQL_DATABASE=solo
MYSQL_MEM_LIMIT=512m
MYSQL_CPU_LIMIT=1.0

# ---- Logging ----------------------------------------------------------------
SOLO_LOG_LEVEL=Info
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
